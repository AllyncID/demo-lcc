PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@lccntb.id
# Set a unique password (at least 12 characters) before starting a fresh database.
ADMIN_PASSWORD=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
DATABASE_PATH=./data/lcc.sqlite
# Local development: messages stay in the private database and are visible only
# to logged-in admins in /admin?tab=mail. Never use local delivery in production.
MAIL_MODE=local
# For real delivery set MAIL_MODE=smtp and configure all required values below.
# Production defaults to smtp and refuses local mode.
SMTP_HOST=
SMTP_PORT=587
# false on port 587 requires STARTTLS; use true on port 465 for implicit TLS.
# TLS and certificate verification are mandatory in both modes.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
